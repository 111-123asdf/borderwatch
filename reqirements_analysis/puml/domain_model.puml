@startuml
skinparam shadowing false
skinparam dpi 150
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 90
hide empty members
title 图4 边境守望领域模型（类图）

package "局外养成" {
  class 玩家档案
  class 英雄养成等级
  class 出战塔组
  abstract class 英雄
  class 骑士
  class 游侠
  class 法师
  class 技能
  abstract class 防御塔类型
  class 弓箭塔
  class 法师塔
  class 火炮塔
  class 兵营
}

package "对局与战斗" {
  class 对局
  class 防御塔
  class 改造流派
  class 改造分支
  class 士兵
  class 敌人
  class 成长卡
  class 结算单
}

package "关卡与波次" {
  class 关卡
  class 道路
  class 塔位
  class 波次
  class 信标
  class 营地
}

' ── 继承 ──
骑士 --|> 英雄
游侠 --|> 英雄
法师 --|> 英雄
弓箭塔 --|> 防御塔类型
法师塔 --|> 防御塔类型
火炮塔 --|> 防御塔类型
兵营 --|> 防御塔类型

' ── 组合 ──
关卡 "1" *-- "1..4" 道路 : 布防地形
关卡 "1" *-- "8..18" 塔位 : 固定建造点
关卡 "1" *-- "8" 波次
关卡 "1" *-- "1" 信标 : 唯一
关卡 "1" *-- "0..2" 营地
英雄 "1" *-- "1..2" 技能
改造流派 "1" *-- "2" 改造分支 : 左右分支

' ── 聚合 ──
出战塔组 "1" o-- "1..4" 防御塔类型 : 装备
兵营 "1" o-- "0..3" 士兵 : 驻军补员

' ── 关联 ──
玩家档案 "1" -- "3" 英雄养成等级 : 每位英雄一条
英雄养成等级 "1" --> "1" 英雄 : 归属
玩家档案 "1" --> "1" 英雄 : 当前出战
玩家档案 "1" --> "1" 出战塔组 : 保存配置
对局 "0..*" --> "1" 关卡 : 选定
对局 "1" --> "0..*" 防御塔 : 建造持有
防御塔 "0..*" -- "0..1" 塔位 : 驻扎(局内唯一)
防御塔 "0..*" --> "0..1" 改造流派 : L3转职
英雄 "1" -- "0..*" 成长卡 : 觉醒持有
成长卡 "0..*" -- "0..*" 成长卡 : 联动/套装
营地 "1" -- "1..3" 敌人 : 驻防守卫
英雄 "0..1" --> "0..*" 敌人 : 拦截(英雄)
士兵 "0..1" --> "0..*" 敌人 : 拦截(士兵)
敌人 "0..*" --> "1" 道路 : 沿路行进
敌人 "0..*" --> "1" 信标 : 漏怪伤害
对局 "1" -- "0..1" 结算单 : 一局一结算

' ── 依赖 ──
波次 ..> 敌人 : 按编组出怪
防御塔 ..> 防御塔类型 : 取型建造
成长卡 ..> 技能 : 解锁前置
结算单 ..> 玩家档案 : 钻石入账
@enduml
